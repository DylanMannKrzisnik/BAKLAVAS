# Environment variables for BAKLAVA (HPO, MLflow, etc.).
# Copy to .env and set values, then: set -a && source .env && set +a
# Or export vars before running scripts. HPO also accepts --mlflow-base-dir.

# Base directory for MLflow tracking DB and artifacts (e.g. parent of repo).
# When set, one SQLite DB and one artifact tree are used.
export MLFLOW_BASE_DIR=/path/to/BAKLAVA_base

# --- Viewing runs in MLflow UI ---
# Run from ANY directory (the CWD does not matter). Use the SAME backend as the script:
#
#   If you set MLFLOW_BASE_DIR (or --mlflow-base-dir):
#     # NOTE: for an absolute path, MLflow/SQLAlchemy expects 4 slashes after sqlite:
#     mlflow ui --backend-store-uri sqlite:////${MLFLOW_BASE_DIR}/mlflow_tracking/mlflow.db
#
#   If you did NOT set it, runs are under cache_dir (e.g. latest outputs/.../multimodal/<timestamp>).
#     Find the DB at: <cache_dir>/mlflow_tracking/<study_name>/mlflow.db
#     Then: mlflow ui --backend-store-uri sqlite:///<cache_dir>/mlflow_tracking/<study_name>/mlflow.db
#
# Open the URL shown (e.g. http://127.0.0.1:5000).
